# =====================================================================
# GPU Preference Ranking System — Environment Variables
# Salin file ini menjadi .env.local lalu isi dengan kredensial project
# Supabase Anda (Project Settings → API).
# =====================================================================

# URL project Supabase, contoh: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key (AMAN dipakai di browser karena RLS aktif)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opsional — set "false" untuk menutup halaman registrasi admin (/register)
NEXT_PUBLIC_ALLOW_ADMIN_SIGNUP=true

# Opsional — set "false" untuk menutup halaman kuesioner publik (/survey)
NEXT_PUBLIC_ENABLE_PUBLIC_SURVEY=true
